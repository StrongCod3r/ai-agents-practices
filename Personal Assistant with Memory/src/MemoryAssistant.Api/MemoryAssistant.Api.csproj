<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>memory-assistant-local-example</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MemoryAssistant.Application/MemoryAssistant.Application.csproj" />
    <ProjectReference Include="../MemoryAssistant.Infrastructure/MemoryAssistant.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
    <PackageReference
      Include="Microsoft.EntityFrameworkCore.Design"
      Version="10.0.12"
      PrivateAssets="all"
    />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.0" />
  </ItemGroup>
</Project>
